<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to trigger the system PackageInstaller for OTA APK updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Read the active transport (wifi/cellular/none) for the vitals session header. Normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read wifi RSSI for signal-level vitals (0–4 bars). Normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Mic capture for voice conversations (E1 AudioRecord). Runtime prompt handled by the app (E5/E6). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:name=".SentientApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Sentient.Splash">
        <!-- OTA install-status sink for PackageInstaller PendingIntent callbacks. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
