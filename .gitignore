venv/
__pycache__/
*.pyc
*.egg-info/

# Docker
.docker/

# Worktrees
.worktrees/
.claude/worktrees/

# Playwright MCP browser session artifacts
.playwright-mcp/

# Logs
logs/
*.log
profiles/*/.env
deploy/docker/run/

# qa-session per-run artifacts (committed: bugs/, issues.md, index.json, charters/, config.yml, oracles.md, recon.sh)
qa/*/sessions/
qa/*/.playwright/
# qa e2e run artifacts across subdirs — screenshots/recordings/log-dumps/result-bundles.
# (*.png and *.log are already ignored repo-wide; flows/, fixtures/, charters/ stay committed.)
qa/*/screens/
qa/*/logs/
qa/*/results/

# Playwright + smoke screenshots produced during dev sessions
*.png
!**/public/**/*.png
!**/icons/*.png
!**/Assets.xcassets/**/*.png
# Reviewed design prototypes are durable implementation inputs.
!design/prototype/**
# Repository security and machine-junk exclusions still apply inside prototypes.
design/prototype/**/.DS_Store
design/prototype/**/.env
design/prototype/**/.env.local
design/prototype/**/.env.*.local
design/prototype/**/secrets.enc
design/prototype/**/*.jks
design/prototype/**/*.keystore

# iOS per-machine debug backend (see ios/App/Local.xcconfig.example)
ios/App/Local.xcconfig

# Mobile release signing + deploy config — NEVER commit (templates use *.example)
android/release.keystore
*.jks                       # JKS/keystore files have no legitimate committed use anywhere
*.keystore                  # same — covers android/release.keystore and any stray keystore
android/keystore.properties
scripts/release.local.conf

# Fastlane build artifacts (not secrets, just noise)
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md

#Pi/PiBox
/.pibox/
!/.pibox/
/.pibox/*
!/.pibox/verification.yaml
/.worktree/
