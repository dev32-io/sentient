# Sentient cube — PROD profile.
# Hardened build for family / shared deployment. No remote debug surface.
# No HIL verbs. Compiler optimized for size + speed.

# Devtool verb gates off — prod has no HIL/debug verb surface. Names
# preserved from the retired agent_console Kconfig; symbols now live in
# main/Kconfig.projbuild after Task 27 deleted the agent_console component.
CONFIG_AGENT_CONSOLE_DESTRUCTIVE=n
CONFIG_AGENT_CONSOLE_LAYOUT_INSPECTOR=n

# LVGL widget metadata off (saves flash, no agent introspection needed).
CONFIG_LV_USE_OBJ_NAME=n
CONFIG_LV_USE_OBJ_ID=n
CONFIG_LV_USE_OBJ_ID_BUILTIN=n

# esp32-devtool companion + UDP log shipping disabled — prod doesn't ship
# logs to a local sink and has no remote debug surface.
CONFIG_ESP32_DEVTOOL_COMPANION_ENABLE=n

# INFO log level (warnings + errors visible; debug noise gone).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Release build — size optimize, assertions off (faster, smaller).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
