# Generated by xcodegen from project.yml — regenerate with `xcodegen generate`
# Holds GUI-set signing (DEVELOPMENT_TEAM) — gitignored, so it's never committed
# and is regenerated fresh from project.yml + Local.xcconfig on each `xcodegen generate`.
SentientApp.xcodeproj/
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Signing assets — NEVER commit. Cert + private key live in the macOS Keychain;
# provisioning profiles come from the Apple developer portal. These must not enter git.
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.p8
