// Copy to ios/App/Local.xcconfig (gitignored). Sets the DEBUG gateway URL.
// xcconfig GOTCHA: `//` starts a comment ANYWHERE on a line, so a literal
// `wss://...` truncates to `wss:`. Put `$()` BETWEEN the two slashes (`/$()/`)
// so no literal `//` appears in source; `$()` expands to empty at build time →
// resolved value is wss://host:8888/api/v1/ws.
GATEWAY_WS_URL = wss:/$()/localhost:8888/api/v1/ws
