{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentient.local/schemas/design-foundation-v2.schema.json",
  "title": "Sentient design foundation v2",
  "type": "object",
  "required": ["version", "colors", "typography", "spacingPx", "radiiPx", "pill", "motion", "materials", "componentStates", "avatars"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "2.0.0" },
    "description": { "type": "string" },
    "colors": { "$ref": "#/$defs/nonEmptyRecord" },
    "typography": {
      "type": "object",
      "required": ["families", "sizesPx", "lineHeights"],
      "properties": {
        "families": { "$ref": "#/$defs/nonEmptyRecord" },
        "sizesPx": { "$ref": "#/$defs/nonEmptyRecord" },
        "lineHeights": { "$ref": "#/$defs/nonEmptyRecord" }
      },
      "additionalProperties": false
    },
    "spacingPx": { "$ref": "#/$defs/nonEmptyRecord" },
    "radiiPx": { "$ref": "#/$defs/nonEmptyRecord" },
    "pill": { "type": "object", "required": ["kind", "cssValue", "kotlinValue"] },
    "motion": { "type": "object", "required": ["feedbackMs", "stateTransitionMs", "respondingCadenceMs"] },
    "materials": { "type": "object", "required": ["physicalModel", "recipes"] },
    "componentStates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "avatars": { "type": "object", "required": ["sentient", "user"] }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyRecord": { "type": "object", "minProperties": 1 }
  }
}
