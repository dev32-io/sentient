-- Version 1 snapshots predate freshness and access metadata. Existing rows
-- remain complete and namespace-bound while the new metadata is backfilled.
ALTER TABLE calendar_month_snapshot
  ADD COLUMN last_accessed_at INTEGER NOT NULL DEFAULT 0;

ALTER TABLE calendar_month_snapshot
  ADD COLUMN freshness TEXT NOT NULL DEFAULT 'stale';

CREATE INDEX calendar_month_snapshot_lru
  ON calendar_month_snapshot(account_id, backend_id, last_accessed_at);
