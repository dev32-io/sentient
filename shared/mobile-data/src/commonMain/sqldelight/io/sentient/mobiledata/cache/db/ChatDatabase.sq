CREATE TABLE message (
  entry_id TEXT NOT NULL PRIMARY KEY,
  conversation_id TEXT NOT NULL,
  seq INTEGER NOT NULL,
  role TEXT NOT NULL,
  content TEXT NOT NULL,
  ts INTEGER NOT NULL,
  cutoff_kind TEXT
);
CREATE INDEX message_by_conversation ON message(conversation_id, seq);

CREATE TABLE session (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  updated_at INTEGER NOT NULL
);

-- write-through (live entries, upsert by entryId)
-- INSERT OR REPLACE is equivalent here because every column is supplied;
-- ON CONFLICT ... DO UPDATE requires SQLite ≥ 3.24 (dialect not yet pinned).
upsertMessage:
INSERT OR REPLACE INTO message(entry_id, conversation_id, seq, role, content, ts, cutoff_kind)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- instant paint (ordered by seq)
messagesFor:
SELECT * FROM message WHERE conversation_id = ? ORDER BY seq ASC;

-- REST replace-on-reload: wipe a conversation then re-insert
deleteConversation:
DELETE FROM message WHERE conversation_id = ?;

-- INSERT OR REPLACE equivalent: all columns supplied, no partial-update needed.
upsertSession:
INSERT OR REPLACE INTO session(id, title, updated_at) VALUES (?, ?, ?);

allSessions:
SELECT * FROM session ORDER BY updated_at DESC;

deleteSession:
DELETE FROM session WHERE id = ?;

-- smart-async deletion: the full local session id set to diff against the server list
allSessionIds:
SELECT id FROM session;
