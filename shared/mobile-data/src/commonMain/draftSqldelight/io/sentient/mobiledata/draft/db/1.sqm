CREATE TEMP TABLE pending_backup AS SELECT account_id, gateway_id, pending_id, mint_key, surface_id, draft_id, draft_revision, session_id, text, created_at FROM native_pending_send ORDER BY created_at, pending_id;
CREATE TEMP TABLE attachment_backup AS SELECT account_id, gateway_id, pending_id, attachment_id, display_name, media_type, size_bytes, local_path, sort_order FROM native_pending_attachment;
DROP TABLE native_pending_attachment;
DROP TABLE native_pending_send;
CREATE TABLE native_pending_send (
  account_id TEXT NOT NULL,
  gateway_id TEXT NOT NULL,
  pending_id TEXT NOT NULL,
  mint_key TEXT NOT NULL,
  surface_id TEXT NOT NULL,
  draft_id TEXT NOT NULL,
  draft_revision INTEGER NOT NULL,
  session_id TEXT,
  text TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  accepted_order INTEGER NOT NULL,
  attempted INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (account_id, gateway_id, pending_id)
);

CREATE TABLE native_pending_attachment (
  account_id TEXT NOT NULL,
  gateway_id TEXT NOT NULL,
  pending_id TEXT NOT NULL,
  attachment_id TEXT NOT NULL,
  display_name TEXT NOT NULL,
  media_type TEXT NOT NULL,
  size_bytes INTEGER NOT NULL,
  local_path TEXT NOT NULL,
  sort_order INTEGER NOT NULL,
  PRIMARY KEY (account_id, gateway_id, pending_id, attachment_id),
  FOREIGN KEY (account_id, gateway_id, pending_id)
    REFERENCES native_pending_send(account_id, gateway_id, pending_id) ON DELETE CASCADE
);

INSERT INTO native_pending_send SELECT account_id, gateway_id, pending_id, mint_key, surface_id,
draft_id, draft_revision, session_id, text, created_at, rowid, 1 FROM pending_backup;
INSERT INTO native_pending_attachment SELECT account_id, gateway_id, pending_id, attachment_id, display_name, media_type, size_bytes, local_path, sort_order FROM attachment_backup;
DROP TABLE attachment_backup;
DROP TABLE pending_backup;

-- A v1 crash after freeze but before clear must not expose accepted bytes as editable.
DELETE FROM native_draft_attachment
WHERE EXISTS (
  SELECT 1 FROM native_draft d JOIN native_pending_send p
    ON p.account_id = d.account_id AND p.gateway_id = d.gateway_id AND p.draft_id = d.draft_id
  WHERE d.account_id = native_draft_attachment.account_id
    AND d.gateway_id = native_draft_attachment.gateway_id
    AND d.draft_id = native_draft_attachment.draft_id AND d.revision = p.draft_revision
);
UPDATE native_draft SET text = '', revision = revision + 1
WHERE EXISTS (
  SELECT 1 FROM native_pending_send p
  WHERE p.account_id = native_draft.account_id AND p.gateway_id = native_draft.gateway_id
    AND p.draft_id = native_draft.draft_id AND p.draft_revision = native_draft.revision
);
