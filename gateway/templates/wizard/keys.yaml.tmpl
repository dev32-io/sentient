# gateway/templates/wizard/keys.yaml.tmpl
schema_version: "1.0.0"

llm:
  active: "ollama-cloud"

  ollama_cloud:
    api_key: null
    # Ollama Cloud is internet-hosted. `host.docker.internal` was the retired
    # Docker-local endpoint and cannot resolve from the native macOS gateway.
    base_url: "https://ollama.com/v1"

  openrouter:
    api_key: null
    base_url: null

  custom:
    api_key: null
    base_url: null

home_assistant:
  url: null
  local_ip: null
  observe_token: null
  mcp_server_token: null

music_assistant:
  url: null
  local_ip: null
  token: null

# Optional APNs signing values for the managed Gorush addon. Put the base64 of
# the .p8 file here; never commit the key or place it in gateway/config.yaml.
push:
  apns_key_base64: null
  apns_key_id: null
  apns_team_id: null

admin_token: "{{admin_token}}"
