# Generated by gateway profile-renderer; do not edit by hand.
model:
{{model_section}}
streaming:
  enabled: true
  transport: edit
compression:
  enabled: true
  threshold: {{compression_threshold}}
# Persistent memory — Hermes-managed MEMORY.md (agent notes) and USER.md
# (user profile). Char limits MUST be Hermes upstream defaults; webui
# enforces the same caps so user edits never exceed what Hermes' agent
# pruner expects. Do not raise these without revisiting webui caps.
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
{{gateway_signal_block}}{{agent_block}}mcp_servers:
{{mcp_servers_block}}
max_output_tokens: {{max_tokens}}
{{extra_system_prompt_block}}