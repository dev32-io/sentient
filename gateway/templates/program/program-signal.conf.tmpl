[program:hermes-{{userId}}-gateway]
; Per-profile Hermes IM-platform runner. Boots whatever platforms have env
; configured in the profile's .env file. For Sentient v1 that's Signal only.
; Retries on its own loop until SIGNAL_HTTP_URL responds — so startup ordering
; vs the shared sentient-signal-cli sidecar is handled by Hermes internally.
;
; The agent loop inside `hermes -p X gateway run` invokes the LLM (for replies
; to inbound Signal DMs and for cron-driven scheduled cycles) and the terminal
; tool — same code paths as the ACP bridge. So this program needs the SAME env
; footprint as `hermes-X-acp`. Without the per-provider API-key fragment the
; runner crashes at agent construction with
; `RuntimeError: Provider 'X' is set ... but no API key was found`, even though
; everything upstream of the agent (signal-cli daemon, /api/v1/events SSE)
; is healthy.
; Full venv path — supervisord's [program] PATH does not include
; /opt/hermes/.venv/bin (PATH is inherited from supervisord process env,
; not from the hermes user shell). Bare `hermes` resolves on macOS Docker
; Desktop (where /opt/hermes/.venv ends up earlier in the image PATH) but
; fails on linux/arm64 (Pi 5) with "ERROR (spawn error)". ACP and dashboard
; programs already use the full path — keep this consistent.
command=/opt/hermes/.venv/bin/hermes -p {{userId}} gateway run
autostart=true
autorestart=true
startretries=5
startsecs=10
stopwaitsecs=10
stderr_logfile={{hermesHome}}/gateway.err.log
stdout_logfile={{hermesHome}}/gateway.out.log
environment=
  HERMES_HOME="{{hermesHome}}",
  SENTIENT_HERMES_BEARER="{{token}}",
  TERMINAL_ENV="docker",
  TERMINAL_DOCKER_IMAGE="nikolaik/python-nodejs:python3.11-nodejs20",
  TERMINAL_DOCKER_NETWORK="sentient-internal",
  TERMINAL_DOCKER_FORWARD_ENV='["TZ","HTTP_PROXY","HTTPS_PROXY","NO_PROXY"]',
  TERMINAL_CWD="/workspace",
  TERMINAL_TIMEOUT="180",
  TERMINAL_LIFETIME_SECONDS="300",
  TERMINAL_CONTAINER_PERSISTENT="true",
  HTTP_PROXY="http://sentient-egress-proxy:3128",
  HTTPS_PROXY="http://sentient-egress-proxy:3128",
  NO_PROXY="localhost,127.0.0.1",
  {{env_block}}
  TZ="{{timezone}}"
