+def _coerce_docker_network(raw: str) -> "bool | str":
+    """Sentient overlay: parse TERMINAL_DOCKER_NETWORK env var.
 
+    Empty / unset / "true" -> True (default bridge).
+    "false" / "none" / "0" -> False (--network=none).
+    Anything else -> string (custom network name passed via --network <name>).
+    """
+    s = (raw or "").strip()
+    if not s or s.lower() in ("true", "1", "yes"):
+        return True
+    if s.lower() in ("none", "false", "0", "no"):
+        return False
+    return s
+
