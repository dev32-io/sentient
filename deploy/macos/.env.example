# Sentient — macOS Docker Desktop env.
# Copy to .env and fill in HOST_DOCKER_GID:
#   cp deploy/macos/.env.example deploy/macos/.env

# Inside Docker Desktop's Linux VM, the docker socket is owned by group GID 0.
# Detect with:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c '%g' /var/run/docker.sock
HOST_DOCKER_GID=
