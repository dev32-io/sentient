# Sentient — macOS Docker Desktop production env.
# Copy to .env and fill in HOST_DOCKER_GID:
#   cp deploy/mac-prod/.env.example deploy/mac-prod/.env

# Inside Docker Desktop's Linux VM, the docker socket is owned by group GID 0.
# Detect with:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c '%g' /var/run/docker.sock
HOST_DOCKER_GID=

# Optional — timezone for container logs/timestamps (default America/Vancouver).
# TZ=America/Vancouver

# Optional — pin the Hermes base image version. Defaults to the value baked
# into the compose (see deploy/hermes-overlay/HERMES_VERSION).
# HERMES_VERSION=v2026.4.23
