{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa/design-refresh/visual-review.schema.json",
  "title": "Structured non-pixel visual review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": { "const": 1 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "measurement": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["applicable", "value", "unit", "result"], "properties": { "applicable": { "const": true }, "value": { "type": "number", "minimum": 0 }, "unit": { "enum": ["css-px", "pt"] }, "result": { "enum": ["pass", "needs-review"] } } },
        { "type": "object", "additionalProperties": false, "required": ["applicable", "reason"], "properties": { "applicable": { "const": false }, "reason": { "type": "string", "minLength": 1 } } }
      ]
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceId", "inventoryId", "status", "configurations", "evidencePaths", "measurements", "nativeAdaptation", "reviewerNotes"],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^VE-(WEB|IOS)-[A-Z0-9-]+$" },
        "inventoryId": { "type": "string", "pattern": "^(web|ios)\\." },
        "status": { "enum": ["pending", "reviewed"] },
        "configurations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidencePaths": { "type": "array", "items": { "type": "string" } },
        "measurements": { "type": "object", "additionalProperties": false, "required": ["overflow", "minimumTarget", "focus"], "properties": { "overflow": { "$ref": "#/$defs/measurement" }, "minimumTarget": { "$ref": "#/$defs/measurement" }, "focus": { "$ref": "#/$defs/measurement" } } },
        "nativeAdaptation": { "type": "string" },
        "reviewerNotes": { "type": "string" }
      }
    }
  }
}
